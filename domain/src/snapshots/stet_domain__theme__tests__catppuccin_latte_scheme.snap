---
source: domain/src/theme.rs
expression: "theme.style_scheme_xml(\"stet-snapshot\", name)"
---
<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="stet-snapshot" name="catppuccin_latte" version="1.0">
  <author>Stet</author>
  <description>Generated from the Omarchy palette.</description>
  <metadata>
    <property name="variant">light</property>
