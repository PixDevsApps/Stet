  --sidebar-fg-color: #4c4f69;
  --sidebar-backdrop-color: #e3e4e8;
  --popover-bg-color: #d7d8dc;
  --popover-fg-color: #4c4f69;
  --dialog-bg-color: #d7d8dc;
  --dialog-fg-color: #4c4f69;
  --card-bg-color: #dce0e8;
  --card-fg-color: #4c4f69;
  --border-color: #dce0e8;
  --accent-bg-color: #1e66f5;
  --accent-fg-color: #eff1f5;
  --accent-color: #1e66f5;
  --error-bg-color: #d20f39;
  --error-fg-color: #eff1f5;
