---
source: domain/src/theme.rs
expression: "theme.style_scheme_xml(\"stet-snapshot\", name)"
---
<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="stet-snapshot" name="catppuccin" version="1.0">
  <author>Stet</author>
  <description>Generated from the Omarchy palette.</description>
  <metadata>
    <property name="variant">dark</property>
  </metadata>
  <style name="text" foreground="#cdd6f4" background="#1e1e2e"/>
  <style name="selection" foreground="#cdd6f4" background="#45475a"/>
  <style name="selection-unfocused" foreground="#cdd6f4" background="#353748"/>
  <style name="cursor" foreground="#cdd6f4"/>
  <style name="secondary-cursor" foreground="#585b70"/>
  <style name="current-line" background="#313244"/>
  <style name="line-numbers" foreground="#585b70" background="#1e1e2e"/>
  <style name="current-line-number" foreground="#cdd6f4" background="#313244"/>
  <style name="bracket-match" foreground="#f9e2af" bold="true"/>
  <style name="bracket-mismatch" foreground="#1e1e2e" background="#f38ba8"/>
  <style name="right-margin" foreground="#313244" background="#313244"/>
  <style name="draw-spaces" foreground="#585b70"/>
  <style name="background-pattern" background="#313244"/>
  <style name="search-match" background="#6b635b"/>
  <style name="snippet-focus" background="#333c57"/>
  <style name="map-overlay" background="#585b70"/>
  <style name="stet:search-current" foreground="#1e1e2e" background="#f9e2af"/>
  <style name="stet:smart-highlight" background="#3e4b6b"/>
  <style name="stet:mark" background="#734a5f"/>
  <style name="stet:token-1" background="#4d6c71"/>
  <style name="stet:token-2" background="#745b60"/>
  <style name="stet:token-3" background="#766c62"/>
  <style name="stet:token-4" background="#746078"/>
  <style name="stet:token-5" background="#546d5c"/>
  <style name="stet:bookmark" foreground="#89b4fa"/>
  <style name="stet:compare-added" background="#394545"/>
  <style name="stet:compare-removed" background="#493446"/>
  <style name="stet:compare-changed" background="#333c57"/>
  <style name="stet:compare-moved" background="#493f53"/>
  <style name="stet:compare-changed-text" background="#4e628a"/>
  <style name="stet:compare-padding" background="#2d2d3f"/>
  <style name="def:comment" foreground="#585b70" italic="true"/>
  <style name="def:doc-comment" foreground="#585b70" italic="true"/>
  <style name="def:shebang" foreground="#585b70" bold="true"/>
  <style name="def:doc-comment-element" foreground="#585b70" bold="true" italic="true"/>
  <style name="def:constant" foreground="#f6b6ab"/>
  <style name="def:number" foreground="#f6b6ab"/>
  <style name="def:floating-point" foreground="#f6b6ab"/>
  <style name="def:decimal" foreground="#f6b6ab"/>
  <style name="def:base-n-integer" foreground="#f6b6ab"/>
  <style name="def:boolean" foreground="#f6b6ab"/>
  <style name="def:special-constant" foreground="#f6b6ab"/>
  <style name="def:string" foreground="#a6e3a1"/>
  <style name="def:character" foreground="#a6e3a1"/>
  <style name="def:special-char" foreground="#94e2d5"/>
  <style name="def:keyword" foreground="#f5c2e7"/>
  <style name="def:statement" foreground="#f5c2e7"/>
  <style name="def:operator" foreground="#94e2d5"/>
  <style name="def:function" foreground="#89b4fa"/>
  <style name="def:builtin" foreground="#89b4fa"/>
  <style name="def:type" foreground="#f9e2af"/>
  <style name="def:preprocessor" foreground="#f5c2e7"/>
  <style name="def:error" foreground="#f38ba8" underline="error" underline-color="#f38ba8"/>
  <style name="def:warning" underline="error" underline-color="#f9e2af"/>
  <style name="def:note" foreground="#1e1e2e" background="#f9e2af" bold="true"/>
  <style name="def:net-address" foreground="#89b4fa" underline="low"/>
  <style name="def:underlined" underline="single"/>
  <style name="def:emphasis" italic="true"/>
  <style name="def:strong-emphasis" bold="true"/>
  <style name="def:inline-code" foreground="#a6e3a1"/>
  <style name="def:preformatted-section" foreground="#a6e3a1"/>
  <style name="def:insertion" foreground="#a6e3a1"/>
  <style name="def:deletion" foreground="#f38ba8" strikethrough="true"/>
  <style name="def:link-text" foreground="#89b4fa"/>
  <style name="def:link-symbol" foreground="#585b70"/>
  <style name="def:link-destination" foreground="#89b4fa" italic="true" underline="low"/>
  <style name="def:list-marker" foreground="#94e2d5" bold="true"/>
  <style name="def:thematic-break" foreground="#585b70"/>
  <style name="def:heading" foreground="#f38ba8" bold="true"/>
  <style name="def:heading0" foreground="#f38ba8" bold="true"/>
  <style name="def:heading1" foreground="#f38ba8" bold="true"/>
  <style name="def:heading2" foreground="#f9e2af" bold="true"/>
  <style name="def:heading3" foreground="#f9e2af" bold="true"/>
  <style name="def:heading4" foreground="#a6e3a1" bold="true"/>
  <style name="def:heading5" foreground="#89b4fa" bold="true"/>
  <style name="def:heading6" foreground="#f5c2e7" bold="true"/>
</style-scheme>
