# Preview screenshots for the M1 gate, in real Omarchy themes. Needs Omarchy's themes in
# /usr/share/omarchy/themes, so it is not part of tools/ci.sh; it writes into
# tools/progress/public/. Run from the repository root:
#   tools/headless.sh 20 target/debug/stet --self-test tests/selftest/preview.stet-test

write $TMP/stet/src/main.rs "use std::io;\n\n/// Reads a name and greets it.\nfn main() -> io::Result<()> {\n\tlet mut name = String::new();\n\tio::stdin().read_line(&mut name)?;\n\tlet name = name.trim();\n\tif name.is_empty() {\n\t\treturn Ok(());\n\t}\n\tprintln!(\"Hello, {name}!\");\n\tOk(())\n}\n"
write $TMP/stet/notes.md "# Notes\n\n- tabs, find, palette\n- live Omarchy theme\n"
write $TMP/stet/Cargo.toml "[package]\nname = \"hello\"\nversion = \"0.1.0\"\nedition = \"2024\"\n"

theme-set /usr/share/omarchy/themes/tokyo-night tokyo-night
wait-until assert-theme-source omarchy:tokyo-night
open stet/src/main.rs stet/notes.md stet/Cargo.toml
action previous-tab
assert-language markdown
cursor 5 1
type "- restore closed tabs\n"
action previous-tab
assert-language rust
cursor 7 6
find name
wait-until assert-match-count "4 of 7"
wait-frames 3
screenshot $DIR/../../tools/progress/public/m1-editor-tokyo-night-2026-10-01.png

key find Escape
theme-set /usr/share/omarchy/themes/catppuccin-latte catppuccin-latte
wait-until assert-theme-source omarchy:catppuccin-latte
palette "sa"
wait-frames 3
screenshot $DIR/../../tools/progress/public/m1-palette-catppuccin-latte-2026-10-01.png
palette-close

theme-set /usr/share/omarchy/themes/gruvbox gruvbox
wait-until assert-theme-source omarchy:gruvbox
action next-tab
assert-dirty true
action close-tab
assert-dialog true
wait-frames 3
screenshot $DIR/../../tools/progress/public/m1-close-dialog-gruvbox-2026-10-01.png
respond cancel
