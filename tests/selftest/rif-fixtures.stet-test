open fx/big5.txt
assert-status "| CRLF | Big5 |"
open fx/euc-kr.txt
assert-status "| CRLF | EUC-KR |"
open fx/iso-2022-jp.txt
assert-status "| CRLF | ISO-2022-JP |"
open fx/cr-only.txt
assert-status "| CR | UTF-8 |"
open fx/crlf.txt
assert-status "| CRLF | UTF-8 |"
open fx/long-crlf.txt
assert-status "| CRLF | UTF-8 |"
open fx/mixed-eol.txt
assert-status "| Mixed | UTF-8 |"
open fx/empty.txt
