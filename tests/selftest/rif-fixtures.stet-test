write-hex $TMP/fx/iso-2022-jp.txt 1b2442467c4b5c386c244e2561213c256b2447243921232468246d2437242f242a346a24242437245e243921231b28420d0a
write-hex $TMP/fx/cr-only.txt 6c696e65206f6e650d6c696e652074776f0d6c696e652074687265650d
write-hex $TMP/fx/crlf.txt 610d0a620d0a
write-hex $TMP/fx/long-crlf.txt 
write-hex $TMP/fx/mixed-eol.txt 6f6e650d0a74776f0a74687265650d0a666f75720d
write $TMP/fx/empty.txt ""
write-hex $TMP/fx/nul-text.txt 616263006465660a676869000a
write-hex $TMP/fx/placeholder-text.txt 61e29080620a
write-hex $TMP/fx/placeholder-and-nul.txt 61e290806200630a
write-hex $TMP/fx/invalid-utf8.txt 4d6f73746c79205554462d383a2064c3a96ac3a02076752c20627574206f6e6520627974652069732062726f6b656e3a20ff20686572652e0a
write-hex $TMP/fx/binary-without-cr.txt 
write-hex $TMP/fx/binary-png-header.txt 89504e470d0a1a0a0000000d4948445200000100fffe80
write-hex $TMP/fx/utf32le-bom.txt fffe000068000000690000000a000000

open fx/crlf.txt
action find-in-files
find-mode regex
find "^"
replace-text ">\\n"
fif-folder $TMP/fx
fif-filters "*.txt"
action replace-in-files
wait-until assert-dialog true
respond replace
wait-rif
report-rif
assert-rif searched 32
assert-rif files 23
assert-rif replacements 70
assert-rif skipped 9
assert-rif failed 0
assert-rif open 1

# Every file, byte for byte: changed ones as computed, skipped ones as they were.
