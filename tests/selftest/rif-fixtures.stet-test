# Why each skipped file was left alone.
assert-results-contains "nul-text.txt (2 matches not replaced: binary file)"
assert-results-contains "utf32le-bom.txt (2 matches not replaced: binary file)"
assert-results-contains "utf16le-unpaired-surrogate.txt (1 match not replaced: can't be read exactly as UTF-16LE"
assert-results-contains "shift-jis-lossy.txt (3 matches not replaced: can't be read exactly as Shift_JIS"
assert-results-contains "gb18030-lossy.txt (4 matches not replaced: can't be read exactly as gb18030"

# The open document took the edit in its buffer and was saved, as one undoable step.
assert-text ">\na\n>\nb\n"
assert-dirty false

# Opened again, each changed file shows the encoding and line ending it had.
open fx/utf8.txt
assert-status "| LF | UTF-8 |"
open fx/utf8-bom.txt
assert-status "| CRLF | UTF-8 BOM |"
open fx/utf16le-bom.txt
assert-status "| CRLF | UTF-16 LE BOM |"
open fx/utf16be-bom.txt
assert-status "| CRLF | UTF-16 BE BOM |"
open fx/utf16le.txt
assert-status "| LF | UTF-16 LE |"
open fx/utf16be.txt
assert-status "| LF | UTF-16 BE |"
open fx/utf16le-cjk.txt
assert-status "| CRLF | UTF-16 LE |"
open fx/windows-1252.txt
assert-status "| CRLF | Windows-1252 |"
open fx/iso-8859-15.txt
