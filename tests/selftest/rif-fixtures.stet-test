# Replace in Files keeps each file's encoding, BOM and line endings on every fixture (the M8
# exit criterion; ADR-005 amendment of 2026-10-01). The fixtures mirror
# infrastructure/src/encoding/fixtures.rs, with long-crlf shortened. One run of the regex `^`
# with `>\n` puts a line of its own before every line, in a temporary folder only: each insert
# lands next to the file's own bytes, its line break is the file's dominant line ending, and
# it is written in the file's encoding after its BOM. The expected bytes were computed at the
# byte level (code units for UTF-16) without any text codec: ">" and the dominant line ending
# after the BOM and after every line break but a final one. Binary files and files that
# can't be read exactly are skipped, unchanged, and listed with the reason.

mkdir $TMP/fx
write-hex $TMP/fx/utf8.txt 48656c6c6f2c2077c3b6726c6420e2809420e29c9320e6bca2e5ad9720f09f8e890a7365636f6e64206c696e650a
write-hex $TMP/fx/utf8-bom.txt efbbbf424f4d20746578740d0a776974682043524c460d0a
write-hex $TMP/fx/utf16le-bom.txt fffe570069006400650020007400650078007400200077006900740068002000610020004e0055004c00200000002c0020006100200073007500720072006f0067006100740065002000700061006900720020003cd889df200061006e0064002000fc002e000d000a004e0065007800740020006c0069006e0065002e000d000a00
write-hex $TMP/fx/utf16be-bom.txt feff00570069006400650020007400650078007400200077006900740068002000610020004e0055004c00200000002c0020006100200073007500720072006f0067006100740065002000700061006900720020d83cdf8900200061006e0064002000fc002e000d000a004e0065007800740020006c0069006e0065002e000d000a
write-hex $TMP/fx/utf16le.txt 5500540046002d0031003600200077006900740068006f0075007400200061002000620079007400650020006f00720064006500720020006d00610072006b002c002000610020004e0055004c0020000000200061006e00640020003cd889df2e000a005300650063006f006e00640020006c0069006e0065002e000a00
write-hex $TMP/fx/utf16be.txt 005500540046002d0031003600200077006900740068006f0075007400200061002000620079007400650020006f00720064006500720020006d00610072006b002c002000610020004e0055004c0020000000200061006e00640020d83cdf89002e000a005300650063006f006e00640020006c0069006e0065002e000a
write-hex $TMP/fx/utf16le-cjk.txt 2d4e876587652c670cffa16c0967575b82827a988f5e0768b08b02300d000a002c7b8c4e4c8802300d000a00
write-hex $TMP/fx/utf16le-unpaired-surrogate.txt fffe610000d86200
write-hex $TMP/fx/utf16be-odd-length.txt feff0061006200
write-hex $TMP/fx/windows-1252.txt 
write-hex $TMP/fx/iso-8859-15.txt 4c6520707269782065737420646520313020a420706f7572206c27bd75767265203b2064e96ae02076752c20676172e76f6e2c2066656eea7472652c206ff92e0a
write-hex $TMP/fx/windows-1251.txt ddf2ee20eee1fbf7edfbe920f2e5eaf1f220ede020f0f3f1f1eaeeec20ffe7fbeae52c20e7e0efe8f1e0ededfbe920e220eaeee4e8f0eee2eae52057696e646f77732d313235312e0d0a
write-hex $TMP/fx/shift-jis.txt 93fa967b8cea82cc8365834c8358836782c582b7814282d082e782aa82c88141834a835e834a836981418abf8e9a82aa8adc82dc82ea82c482a282dc82b781420d0a93f18d7396da82e082a082e882dc82b781420d0a
