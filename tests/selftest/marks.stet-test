# Mark (M7): Search › Mark… (Ctrl+M) opens the find bar's Mark row. Mark All (Enter in the
# find field) marks every match of the query, in Normal, Extended or Regex mode, with Match
# case and Whole word, through our own engine, in the Find Mark Style or one of the five token
# styles. Bookmark line bookmarks the lines with a match; Purge for each search clears the
# style (and, with Bookmark line, the bookmarks) first. Clear All Marks, Copy Marked Text, and
# Jump Up and Down to the Find Mark Style (Alt+Shift+M and Alt+M). The exit criterion: marking
# a regex with Bookmark line, then Remove Non-Bookmarked Lines, is one undo step.

set-text "apple pie\nbanana split\napple tart\ncherry pie\napple crumble\n"
action mark
assert-bar-mode mark
assert-find-open true
assert-focus find
find "apple"
key find Return
assert-marks mark 3
assert-find-message "Mark: 3 matches"
assert-marked-text mark 2 "apple"
assert-mark-tags mark 3
assert-mark-stats false
assert-bookmarks none
assert-text "apple pie\nbanana split\napple tart\ncherry pie\napple crumble\n"
assert-focus find
# In the Mark row the marks show the matches, not the bar's highlighting; the Find row
# highlights them again.
assert-search-highlight false
wait-frames 2
assert-text-background 3 1 stet:mark
action find
assert-bar-mode find
assert-search-highlight true
action mark
assert-search-highlight false

# Without Purge, another Mark All adds to the style; with it, the style starts over.
find "pie"
action mark-all
assert-marks mark 5
mark-option purge true
action mark-all
assert-marks mark 2
assert-find-message "Mark: 2 matches"

# Bookmark line bookmarks every line with a match; Clear All Marks clears the style and,
# with Bookmark line, the bookmarks.
mark-option bookmark true
find "apple"
action mark-all
assert-marks mark 3
assert-bookmarks 1,3,5
action clear-marks
assert-marks mark 0
assert-mark-tags mark 0
assert-bookmarks none

# Match case and a regex, in the 2nd style.
mark-option bookmark false
mark-option purge false
mark-style 2
find "APPLE"
action mark-all
assert-marks 2 3
find-option case true
action mark-all
assert-find-message "Mark: no matches"
find-option case false
action clear-marks
find-mode regex
find "^\\w+ pie\$"
action mark-all
assert-marks 2 2
assert-marked-text 2 1 "apple pie"
assert-marked-text 2 2 "cherry pie"
assert-mark-tags 2 2

# Copy Marked Text: each marked text on its own line.
action copy-marked-text
assert-clipboard-contains "apple pie\ncherry pie"
assert-toast "Copied 2 marked texts"

# Marks move with edits: text typed at a mark's start stays outside it.
key find Escape
assert-focus editor
cursor 1 1
type "big "
assert-marked-text 2 1 "apple pie"
action undo
assert-marked-text 2 1 "apple pie"

# Jump Down and Up to the Find Mark Style select the next and previous mark, around the end.
action mark
mark-style mark
find-mode normal
find "apple"
action mark-all
key find Escape
cursor 1 1
action jump-down-mark
assert-selection "apple"
assert-cursor 3 6
action jump-down-mark
assert-cursor 5 6
action jump-down-mark
assert-cursor 1 6
action jump-up-mark
assert-cursor 5 6
assert-focus editor

# The exit criterion, small: mark a regex with Bookmark line, remove the other lines, and
# one Undo brings everything back, bookmarks included.
action clear-marks
action mark
mark-option bookmark true
mark-option purge true
find-mode regex
find "^(apple|cherry)"
action mark-all
assert-bookmarks 1,3,4,5
key find Escape
column-checkpoint marked
action remove-unbookmarked-lines
assert-text "apple pie\napple tart\ncherry pie\napple crumble\n"
assert-bookmarks 1,2,3,4
assert-undo-steps marked 1
action undo
assert-text "apple pie\nbanana split\napple tart\ncherry pie\napple crumble\n"
assert-bookmarks 1,3,4,5
assert-marks mark 4
assert-focus editor
