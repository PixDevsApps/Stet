# The + button right of the hamburger menu opens a new tab (1.4), in the view whose strip it is
# on: the main view's, or the second view's while the main view has no tab. It takes the keyboard
# focus to the new tab's editor, as New (Ctrl+N) does.
# Run: tools/headless.sh 73 target/debug/stet --self-test tests/selftest/new-tab-button.stet-test

write $TMP/a.txt "alpha\n"
open a.txt
assert-tab-count 1
assert-menu-at 1
click-new-tab
assert-tab-count 2
assert-tab-title 2 "Untitled 1"
assert-title "Untitled 1 — Stet"
assert-focus editor

# Split, with the second view active: the + is on the main view's strip, and opens its tab there.
action move-to-other-view
assert-split true
assert-active-view 2
assert-menu-at 1
click-new-tab
assert-view-tabs 1 2
assert-view-tabs 2 1
assert-active-view 1
assert-view-shows 1 "Untitled 2"
assert-focus editor

# The main view empty: the + moves with the menu to the second view's strip.
action close-tab
action close-tab
assert-view-tabs 1 0
assert-menu-at 2
click-new-tab
assert-view-tabs 2 2
assert-view-shows 2 "Untitled 2"
assert-focus editor
