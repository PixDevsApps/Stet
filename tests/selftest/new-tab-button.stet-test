# The + after a tab strip's last tab opens a new tab (1.4; after the last tab since 1.5) in that
# strip's view. It takes the keyboard focus to the new tab's editor, as New (Ctrl+N) does. Each
# strip on screen has its own +; when the tabs scroll, it stays at the end of the tabs on screen.
# Run: tools/headless.sh 73 target/debug/stet --self-test tests/selftest/new-tab-button.stet-test

write $TMP/a.txt "alpha\n"
open a.txt
assert-tab-count 1
assert-menu-at 1
assert-new-tab-at 1
click-new-tab 1
assert-tab-count 2
assert-tab-title 2 "Untitled 1"
assert-title "Untitled 1 — Stet"
assert-focus editor
assert-new-tab-at 1

# More tabs than the strip shows: the + stays at the end of the tabs on screen.
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
action new-tab
assert-tab-count 12
assert-new-tab-at 1
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
action close-tab
assert-tab-count 2
assert-new-tab-at 1

# Split, with the second view active: each strip has its +, and each opens its tab in its view.
action move-to-other-view
assert-split true
assert-active-view 2
assert-menu-at 1
assert-new-tab-at 1
assert-new-tab-at 2
click-new-tab 1
assert-view-tabs 1 2
assert-view-tabs 2 1
assert-active-view 1
assert-view-shows 1 "Untitled 2"
assert-focus editor
click-new-tab 2
assert-view-tabs 1 2
assert-view-tabs 2 2
assert-active-view 2
assert-view-shows 2 "Untitled 3"
assert-focus editor
assert-new-tab-at 2

# The main view empty: the second view's strip has the menu, and its + still opens tabs there.
view-focus 1
action close-tab
action close-tab
assert-view-tabs 1 0
assert-menu-at 2
assert-new-tab-at 2
click-new-tab 2
assert-view-tabs 2 3
assert-view-shows 2 "Untitled 2"
assert-focus editor

# A tab dropped on a strip's + or on the empty part after it joins that strip's view as its last
# tab (1.5.1); no tab closes or opens. From the other view, whose last tab it was:
action move-to-other-view
assert-view-tabs 1 1
assert-view-tabs 2 2
assert-view-shows 1 "Untitled 2"
drop-tab 1 2
assert-tab-count 3
assert-view-tabs 1 0
assert-view-tabs 2 3
assert-tab-title 3 "Untitled 2"
assert-view-shows 2 "Untitled 2"
assert-new-tab-at 2

# Within its own view, it becomes the last tab.
assert-tab-title 1 "Untitled 1"
drop-tab 1 2
assert-view-tabs 2 3
assert-tab-title 1 "Untitled 3"
assert-tab-title 3 "Untitled 1"
assert-view-shows 2 "Untitled 1"

# A view with a pinned tab: an unpinned tab goes after all its tabs, and a pinned one stays
# pinned, after the view's other pinned tabs.
action pin-tab
assert-pinned 1 true
assert-tab-title 1 "Untitled 1"
click-tab 3
action move-to-other-view
assert-view-tabs 1 1
assert-view-shows 1 "Untitled 2"
drop-tab 1 2
assert-view-tabs 2 3
assert-tab-title 1 "Untitled 1"
assert-pinned 1 true
assert-tab-title 3 "Untitled 2"
assert-pinned 3 false
click-tab 2
action move-to-other-view
action pin-tab
assert-view-shows 1 "Untitled 3"
assert-pinned 1 true
drop-tab 1 2
assert-tab-count 3
assert-view-tabs 2 3
assert-tab-title 1 "Untitled 1"
assert-tab-title 2 "Untitled 3"
assert-pinned 2 true
assert-tab-title 3 "Untitled 2"
assert-pinned 3 false
