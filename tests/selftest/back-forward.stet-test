# Back and forward (M8): jumps record the place they leave; Go Back (Alt+Left, mouse button
# 8) and Go Forward (Alt+Right, button 9) move through them, across tabs; places within 10
# lines merge, edits move them along, and closing a tab drops its places.
# `assert-places` lists the places as name:line, oldest first, and the current one's index.

write-generated $TMP/long.log log 40000
write $TMP/other.txt "other one\nother two\nneedle here\n"
open long.log
assert-places "" -
assert-accels

# Go to Line records where the caret was.
palette ":50"
palette-activate
assert-cursor 50 1
palette ":200"
palette-activate
assert-cursor 200 1
assert-places "long.log:1|long.log:50" 1
action go-back
assert-cursor 50 1
assert-places "long.log:1|long.log:50|long.log:200" 1
action go-back
assert-cursor 1 1
assert-places "long.log:1|long.log:50|long.log:200" 0
action go-back
assert-cursor 1 1
action go-forward
assert-cursor 50 1
assert-focus editor

# The mouse's back and forward buttons.
mouse-button 9
assert-cursor 200 1
mouse-button 8
assert-cursor 50 1
mouse-button 9
assert-cursor 200 1
assert-places "long.log:1|long.log:50|long.log:200" 2

# A place within 10 lines of the current one replaces it instead of adding one.
cursor 205 1
palette ":300"
palette-activate
assert-cursor 300 1
assert-places "long.log:1|long.log:50|long.log:205" 2

# A tab switch records the place left; Go Back returns to it, in its tab.
open other.txt
assert-title "other.txt — $TMP — Stet"
assert-places "long.log:1|long.log:50|long.log:205|long.log:300" 3
action go-back
assert-title "long.log — $TMP — Stet"
assert-cursor 300 1
assert-places "long.log:1|long.log:50|long.log:205|long.log:300|other.txt:1" 3
action go-forward
assert-title "other.txt — $TMP — Stet"
assert-cursor 1 1
action go-back
action go-back
assert-title "long.log — $TMP — Stet"
assert-cursor 205 1

# A new jump after going back ends the places ahead: Go Forward has nowhere to go.
palette ":10"
palette-activate
action go-forward
assert-cursor 10 1
assert-places "long.log:1|long.log:50|long.log:205|long.log:10" 3

# Find Next, and the find bar opening, record where the search started.
cursor 100 1
find "items/2093 status"
assert-cursor 300 73
action find-next
assert-places "long.log:1|long.log:50|long.log:205|long.log:10|long.log:100|long.log:300" 5
find-mode normal
action go-back
assert-cursor 100 1

# Edits move places along: three lines typed at the top move the places after them, and
# Go Back finds line 100 at 103.
cursor 1 1
type "one\ntwo\nthree\n"
assert-places "long.log:1|long.log:53|long.log:208|long.log:13|long.log:103|long.log:303" 4
action go-back
assert-cursor 103 1

# Next Search Result records the place it left.
action find-all-in-document
wait-idle
cursor 1 1
action next-search-result
assert-cursor 303 73
action go-back
assert-cursor 1 1

# Closing a tab drops its places; the others stay.
open other.txt
assert-title "other.txt — $TMP — Stet"
action go-back
assert-title "*long.log — $TMP — Stet"
action go-forward
assert-title "other.txt — $TMP — Stet"
action close-tab
assert-tab-count 1
assert-title "*long.log — $TMP — Stet"
assert-places "long.log:1|long.log:53|long.log:208|long.log:13|long.log:103|long.log:1" 5
action go-back
assert-title "*long.log — $TMP — Stet"
action go-forward
assert-title "*long.log — $TMP — Stet"
