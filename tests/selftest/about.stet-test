# Help › About Stet (1.3.2): what Stet is, with its website, copyright and license.
# Run: tools/headless.sh 20 target/debug/stet --self-test tests/selftest/about.stet-test

action about
wait-frames 2
assert-dialog-text "Stet is a fast, keyboard-first text and code editor for Omarchy"
assert-dialog-text "It never loses your work"
assert-dialog-text "it keeps each file's encoding and line endings as they were."
assert-dialog-text "Stet contributors"
assert-dialog-text "© 2026 Stet contributors"
