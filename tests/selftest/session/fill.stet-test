# Child of session-restore.stet-test (its scratch directory is the parent's $TMP/c): 40 dirty
# and untitled tabs plus three with a format or language of their own, backed up by the 7 s
# timer; then typing that the parent's SIGKILL, right after, loses.

# M1's recent.json, written by the parent, comes into the session.
assert-recent /tmp/stet-m1-recent.txt
generate-tabs $TMP/files 20 20
write $TMP/files/crlf.txt "dos\r\nfile\r\n"
open files/crlf.txt
cursor 2 5
type "!"
write-hex $TMP/files/latin1.txt "63 61 66 e9 0a"
open files/latin1.txt
action convert-to-utf8
wait-idle
assert-dirty true
action new-tab
type "fn main() {}\n"
choose-language rust
assert-language rust
set-history find "kept|searches"
action zoom-in
action zoom-in
set-window-size 900 640
assert-tab-count 43
wait-backed-up 8000
assert-backups $TMP/state/stet 43
wait-until assert-missing $TMP/state/stet/recent.json
tabs-digest $TMP/digest-backed-up
# Typing after the last backup: the SIGKILL that follows loses it.
select-tab 1
type "LOST"
write $TMP/ready "1"
sleep 120000
