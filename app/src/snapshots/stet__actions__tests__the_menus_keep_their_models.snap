---
source: app/src/actions.rs
expression: out
---
# main with recent files
- label='File'
  <submenu>
    - 
      <section>
        - action='win.new-tab' label='New'
        - action='win.open' label='Open…'
        - action='win.quick-open' label='Quick Open…'
        - action='win.reload-from-disk' label='Reload from Disk'
        - label='Open Recent'
          <submenu>
            - 
              <section>
                - action='win.open-recent' label='todo__list.txt' target=b'/home/user/notes/todo_list.txt'
                - action='win.open-recent' label='a.md' target=b'/tmp/a.md'
                - action='win.open-recent' label='bad�.txt' target=b'/tmp/bad\377.txt'
                - action='win.open-recent' label='/' target=b'/'
            - 
              <section>
                - action='win.clear-recent' label='Clear Recent Files'
    - 
      <section>
        - action='win.save' label='Save'
        - action='win.save-as' label='Save As…'
        - action='win.save-all' label='Save All'
        - action='win.rename-file' label='Rename…'
    - 
      <section>
        - action='win.open-containing-folder' label='Open Containing Folder'
        - action='win.open-terminal-here' label='Open Terminal Here'
    - 
      <section>
        - action='win.close-tab' label='Close'
        - action='win.close-all' label='Close All'
        - action='win.restore-closed-tab' label='Restore Closed Tab'
        - action='win.forget-drafts' label='Forget Unsaved Drafts…'
        - action='win.move-to-trash' label='Move to Trash…'
        - action='win.close-others' label='Close Others'
        - action='win.close-to-the-right' label='Close to the Right'
    - 
      <section>
        - action='app.quit' label='Quit'
- label='Edit'
  <submenu>
    - 
      <section>
        - accel='<Control>z' action='win.undo' label='Undo'
        - accel='<Control>y' action='win.redo' label='Redo'
    - 
      <section>
        - accel='<Control>x' action='win.cut' label='Cut'
        - accel='<Control>c' action='win.copy' label='Copy'
        - accel='<Control>v' action='win.paste' label='Paste'
        - accel='Delete' action='win.delete' label='Delete'
    - 
      <section>
        - accel='<Control>a' action='win.select-all' label='Select All'
        - action='win.column-begin-end-select' label='Begin/End Select in Column Mode'
        - action='win.column-editor' label='Column Editor…'
    - 
      <section>
        - label='Copy to Clipboard'
          <submenu>
            - 
              <section>
                - action='win.copy-full-path' label='Copy Full Path'
                - action='win.copy-file-name' label='Copy File Name'
                - action='win.copy-directory-path' label='Copy Directory Path'
        - label='Convert Case to'
          <submenu>
            - 
              <section>
                - accel='<Alt><Shift>u' action='win.uppercase' label='UPPERCASE'
                - accel='<Control>u' action='win.lowercase' label='lowercase'
                - accel='<Alt>u' action='win.proper-case' label='Proper Case'
                - action='win.proper-case-blend' label='Proper Case (blend)'
                - accel='<Control><Alt>u' action='win.sentence-case' label='Sentence case'
                - action='win.sentence-case-blend' label='Sentence case (blend)'
                - action='win.invert-case' label='iNVERT cASE'
        - label='Line Operations'
          <submenu>
            - 
              <section>
                - accel='<Control>d' action='win.duplicate-line' label='Duplicate Current Line'
                - accel='<Control>l' action='win.cut-line' label='Cut Current Line'
                - accel='<Control><Shift>x' action='win.copy-line' label='Copy Current Line'
                - accel='<Control><Shift>l' action='win.delete-line' label='Delete Current Line'
                - accel='<Control>t' action='win.transpose-line' label='Transpose Current Line'
            - 
              <section>
                - accel='<Control><Shift>Up' action='win.move-line-up' label='Move Up Current Line'
                - accel='<Control><Shift>Down' action='win.move-line-down' label='Move Down Current Line'
                - accel='<Control>j' action='win.join-lines' label='Join Lines'
                - accel='<Control><Alt>Return' action='win.blank-line-above' label='Insert Blank Line Above Current'
                - accel='<Control><Alt><Shift>Return' action='win.blank-line-below' label='Insert Blank Line Below Current'
            - 
              <section>
                - action='win.remove-duplicate-lines' label='Remove Duplicate Lines'
                - action='win.remove-consecutive-duplicate-lines' label='Remove Consecutive Duplicate Lines'
                - action='win.remove-empty-lines' label='Remove Empty Lines'
                - action='win.remove-blank-lines' label='Remove Empty Lines (Containing Blank Characters)'
                - action='win.reverse-lines' label='Reverse Line Order'
            - 
              <section>
                - action='win.sort-lexical-ascending' label='Sort Lines Lexicographically Ascending'
                - action='win.sort-lexical-descending' label='Sort Lines Lexicographically Descending'
                - action='win.sort-ignore-case-ascending' label='Sort Lines Lex. Ascending Ignoring Case'
                - action='win.sort-ignore-case-descending' label='Sort Lines Lex. Descending Ignoring Case'
                - action='win.sort-integer-ascending' label='Sort Lines As Integers Ascending'
                - action='win.sort-integer-descending' label='Sort Lines As Integers Descending'
                - action='win.sort-decimal-comma-ascending' label='Sort Lines As Decimals (Comma) Ascending'
                - action='win.sort-decimal-comma-descending' label='Sort Lines As Decimals (Comma) Descending'
                - action='win.sort-decimal-dot-ascending' label='Sort Lines As Decimals (Dot) Ascending'
                - action='win.sort-decimal-dot-descending' label='Sort Lines As Decimals (Dot) Descending'
                - action='win.sort-length-ascending' label='Sort Lines By Length Ascending'
                - action='win.sort-length-descending' label='Sort Lines By Length Descending'
        - label='Comment/Uncomment'
          <submenu>
            - 
              <section>
                - accel='<Control>q' action='win.toggle-comment' label='Toggle Single Line Comment'
                - accel='<Control>k' action='win.comment-lines' label='Single Line Comment'
                - accel='<Control><Shift>k' action='win.uncomment-lines' label='Single Line Uncomment'
            - 
              <section>
                - accel='<Control><Shift>q' action='win.toggle-block-comment' label='Block Comment'
        - label='EOL Conversion'
          <submenu>
            - 
              <section>
                - action='win.eol-crlf' label='Windows (CR LF)'
                - action='win.eol-lf' label='Unix (LF)'
                - action='win.eol-cr' label='Macintosh (CR)'
        - label='Blank Operations'
          <submenu>
            - 
              <section>
                - action='win.trim-trailing' label='Trim Trailing Space'
                - action='win.trim-leading' label='Trim Leading Space'
                - action='win.trim-both' label='Trim Leading and Trailing Space'
            - 
              <section>
                - action='win.tabs-to-spaces' label='TAB to Space'
                - action='win.spaces-to-tabs' label='Space to TAB (All)'
                - action='win.spaces-to-tabs-leading' label='Space to TAB (Leading)'
    - 
      <section>
        - action='win.add-prefix-suffix' label='Add Prefix/Suffix…'
        - action='win.insert-numbers' label='Insert Numbers…'
- label='Search'
  <submenu>
    - 
