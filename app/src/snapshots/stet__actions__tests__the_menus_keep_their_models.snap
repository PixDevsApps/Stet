                - action='win.style-token-2' label='Using 2nd Style'
                - action='win.style-token-3' label='Using 3rd Style'
                - action='win.style-token-4' label='Using 4th Style'
                - action='win.style-token-5' label='Using 5th Style'
        - label='Clear Style'
          <submenu>
            - 
              <section>
                - action='win.clear-style-1' label='Clear 1st Style'
                - action='win.clear-style-2' label='Clear 2nd Style'
                - action='win.clear-style-3' label='Clear 3rd Style'
                - action='win.clear-style-4' label='Clear 4th Style'
                - action='win.clear-style-5' label='Clear 5th Style'
            - 
              <section>
                - action='win.clear-all-styles' label='Clear All Styles'
        - label='Jump Up'
          <submenu>
            - 
              <section>
                - accel='<Control><Alt>1' action='win.jump-up-1' label='1st Style'
                - accel='<Control><Alt>2' action='win.jump-up-2' label='2nd Style'
                - accel='<Control><Alt>3' action='win.jump-up-3' label='3rd Style'
                - accel='<Control><Alt>4' action='win.jump-up-4' label='4th Style'
                - accel='<Control><Alt>5' action='win.jump-up-5' label='5th Style'
            - 
              <section>
                - accel='<Alt><Shift>m' action='win.jump-up-mark' label='Find Mark Style'
        - label='Jump Down'
          <submenu>
            - 
              <section>
                - accel='<Control>1' action='win.jump-down-1' label='1st Style'
                - accel='<Control>2' action='win.jump-down-2' label='2nd Style'
                - accel='<Control>3' action='win.jump-down-3' label='3rd Style'
                - accel='<Control>4' action='win.jump-down-4' label='4th Style'
                - accel='<Control>5' action='win.jump-down-5' label='5th Style'
            - 
              <section>
                - accel='<Alt>m' action='win.jump-down-mark' label='Find Mark Style'
        - label='Bookmark'
          <submenu>
            - 
