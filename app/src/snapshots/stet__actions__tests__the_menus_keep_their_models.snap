                - action='win.cut-bookmarked-lines' label='Cut Bookmarked Lines'
                - action='win.copy-bookmarked-lines' label='Copy Bookmarked Lines'
                - action='win.paste-to-bookmarked-lines' label='Paste to (Replace) Bookmarked Lines'
