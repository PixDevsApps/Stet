                    - action='win.reinterpret' label='ISO-8859-5' target='ISO-8859-5'
                    - action='win.reinterpret' label='KOI8-R' target='KOI8-R'
                    - action='win.reinterpret' label='KOI8-U' target='KOI8-U'
                    - action='win.reinterpret' label='IBM866' target='IBM866'
                    - action='win.reinterpret' label='Mac Cyrillic' target='x-mac-cyrillic'
                - label='Greek'
                  <submenu>
                    - action='win.reinterpret' label='Windows-1253' target='windows-1253'
                    - action='win.reinterpret' label='ISO-8859-7' target='ISO-8859-7'
