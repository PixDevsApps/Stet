- label='Encoding'
  <submenu>
    - 
      <section>
        - action='win.encode-utf8' label='Encode in UTF-8'
        - action='win.encode-utf8-bom' label='Encode in UTF-8-BOM'
        - action='win.encode-utf16be-bom' label='Encode in UTF-16 BE BOM'
        - action='win.encode-utf16le-bom' label='Encode in UTF-16 LE BOM'
